# Copy to .env and fill in. The .env file is gitignored and must never be committed.

# Signing key for the session cookie. Use a long random string (openssl rand -hex 32).
SESSION_SECRET=change-me-to-a-long-random-string

# Shared login passphrase. 12 characters or more (docs/03_tech_spec.md 6).
APP_PASSCODE=change-me-to-a-passphrase

# Google AI Studio API key used for gemini-2.5-flash receipt parsing.
GEMINI_API_KEY=your-gemini-api-key

# DynamoDB table name (scripts/dev_local.sh defaults to kakeibo-dev).
KAKEIBO_TABLE_NAME=kakeibo-dev

# S3 bucket name for receipt images (scripts/dev_local.sh defaults to kakeibo-dev).
KAKEIBO_BUCKET_NAME=kakeibo-dev

# AWS region for DynamoDB and S3.
AWS_REGION=ap-northeast-1

# Secure attribute of the session cookie: false for local http, true in production.
COOKIE_SECURE=false
